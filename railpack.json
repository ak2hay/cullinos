{
  "$schema": "https://schema.railpack.com",
  "steps": {
    "build": {
      "inputs": [{ "step": "install" }],
      "commands": [
        "...",
        "npm run db:generate",
        "npx turbo run build --filter=@cullinos/api --no-cache"
      ]
    }
  },
  "deploy": {
    "inputs": [{ "step": "build" }],
    "startCommand": "node apps/api/dist/main.js"
  }
}
