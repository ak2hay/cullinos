{
  "$schema": "https://schema.railpack.com",
  "provider": "node",
  "packages": {
    "node": "22"
  },
  "steps": {
    "install": {
      "commands": ["npm ci --include=dev"]
    },
    "build": {
      "inputs": [{ "step": "install" }],
      "commands": [
        "npm run build:api",
        "test -f apps/api/dist/main.js"
      ]
    }
  },
  "deploy": {
    "startCommand": "node index.js"
  }
}
