generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum OrgStatus {
  active
  trial
  suspended
  cancelled
}

enum OutletStatus {
  active
  inactive
  maintenance
}

enum UserStatus {
  active
  inactive
  invited
}

enum EmailOtpPurpose {
  login_2fa
  password_reset
  labs_step_up
}

enum EmailCampaignScope {
  org_customers
  platform_owners
}

enum EmailCampaignStatus {
  sending
  sent
  failed
}

enum SubscriptionStatus {
  trial
  active
  past_due
  suspended
  cancelled
}

enum OrderStatus {
  draft
  confirmed
  preparing
  ready
  served
  completed
  cancelled
  voided
}

enum OrderType {
  dine_in
  takeaway
  delivery
  qr
  online
  room_service
  banquet
}

enum OrderSource {
  pos
  waiter
  customer
  delivery
  api
  gateway
}

enum KOTStatus {
  pending
  preparing
  ready
  served
  cancelled
}

enum PaymentStatus {
  pending
  completed
  failed
  refunded
  partial_refund
}

enum InvoiceStatus {
  draft
  issued
  paid
  partially_paid
  voided
  credit_note
}

enum ShiftStatus {
  open
  closed
}

enum StockMovementType {
  purchase
  sale
  adjustment
  wastage
  transfer
  return
}

enum POStatus {
  draft
  sent
  partial
  received
  cancelled
}

enum GRNStatus {
  draft
  confirmed
  cancelled
}

enum DeliveryStatus {
  pending
  assigned
  picked_up
  in_transit
  delivered
  failed
  cancelled
}

enum RoomStatus {
  available
  occupied
  maintenance
  blocked
}

enum TableStatus {
  available
  occupied
  reserved
  cleaning
  billing
}

enum TableSessionStatus {
  active
  closed
}

enum ReservationStatus {
  pending
  confirmed
  seated
  cancelled
  no_show
}

enum ReservationInviteStatus {
  sent
  booked
  expired
  cancelled
}

enum ServiceRequestType {
  waiter
  bill
  water
  cutlery
  napkins
  other
}

enum ServiceRequestStatus {
  open
  acknowledged
  resolved
  cancelled
}

enum BanquetStatus {
  inquiry
  confirmed
  in_progress
  completed
  cancelled
}

enum AttendanceStatus {
  present
  absent
  late
  half_day
  leave
}

enum DeviceType {
  pos
  kds
  printer
  gateway
  scanner
  other
}

enum SyncEventStatus {
  pending
  synced
  failed
  conflict
}

enum NotificationChannel {
  in_app
  email
  sms
  push
}

enum MarketingContentStatus {
  draft
  published
}

enum BusinessType {
  restaurant
  cafe
  food_truck
  bakery
  qsr
  cloud_kitchen
  catering
}

enum RestaurantSize {
  small
  medium
  large
}

enum OperatingMode {
  full_service
  counter
  hybrid
}

enum PriceType {
  retail
  wholesale
}

enum ProductionBatchStatus {
  planned
  in_progress
  completed
  cancelled
}

enum CentralKitchenIndentStatus {
  pending
  approved
  fulfilled
  cancelled
}

// ─── Multi-tenant core ───────────────────────────────────────────────────────

model Organization {
  id              String          @id @default(cuid())
  name            String
  slug            String          @unique
  rkyvesClientId  String?         @unique @map("rkyves_client_id")
  businessType    BusinessType    @default(restaurant) @map("business_type")
  restaurantSize  RestaurantSize? @map("restaurant_size")
  status          OrgStatus       @default(trial)
  gstin           String?
  pan             String?
  email           String?
  phone           String?
  address         String?
  city            String?
  state           String?
  country         String    @default("IN")
  timezone        String    @default("Asia/Kolkata")
  currency        String    @default("INR")
  logoUrl            String?   @map("logo_url")
  razorpayCustomerId String?   @map("razorpay_customer_id")
  /// 0 = Sandbox (QA/demo), 1 = Live (real customers). Default Live.
  environmentClass   Int       @default(1) @map("environment_class")
  /// Honored only when environmentClass = 0
  sandboxSkipEmailOtp  Boolean @default(true) @map("sandbox_skip_email_otp")
  sandboxSkipSmsOtp    Boolean @default(true) @map("sandbox_skip_sms_otp")
  sandboxRelaxPassword Boolean @default(true) @map("sandbox_relax_password")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  brands              Brand[]
  outlets             Outlet[]
  users               User[]
  roles               Role[]
  auditLogs           AuditLog[]
  subscriptions       Subscription[]
  settings            OrganizationSettings?
  menuCategories      MenuCategory[]
  menuItems           MenuItem[]
  orders              Order[]
  customers             Customer[]
  inventoryItems        InventoryItem[]
  suppliers             Supplier[]
  employees             Employee[]
  notifications         Notification[]
  integrations          Integration[]
  menuSchedules         MenuSchedule[]
  outletEvents          OutletEvent[]
  productionBatches     ProductionBatch[]
  devices               Device[]
  syncEvents            SyncEvent[]
  taxGroups             TaxGroup[]
  printJobs             PrintJob[]
  deliveryZones         DeliveryZone[]
  guests                Guest[]
  franchiseAgreements   FranchiseAgreement[]
  analyticsSnapshots    AnalyticsSnapshot[]
  emailCampaigns        EmailCampaign[]
  loyaltyRewards        LoyaltyReward[]
  payments              Payment[]
  consentRecords        ConsentRecord[]
  impersonationHandoffs ImpersonationHandoff[]
  serviceRequests       ServiceRequest[]
  guestMemberships      GuestOrgMembership[]
  guestBanners          GuestBanner[]
  guestPushCampaigns    GuestPushCampaign[]
  aggregatorSettlements AggregatorSettlement[]
  reservations          Reservation[]
  reservationInvites    ReservationInvite[]
  smsCampaigns          SmsCampaign[]
  feedbackResponses     FeedbackResponse[]
  promoDisplaySlides    PromoDisplaySlide[]
  wastageRecords        Wastage[]
  centralKitchens       CentralKitchen[]
  centralKitchenIndents CentralKitchenIndent[]
  wallet                OrganizationWallet?

  @@map("organizations")
}

model OrganizationSettings {
  id             String  @id @default(cuid())
  organizationId String  @unique @map("organization_id")
  settings       Json    @default("{}")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organization_settings")
}

/// Prepaid Cullinos portal wallet (SMS campaigns, future metered addons).
model OrganizationWallet {
  organizationId String   @id @map("organization_id")
  balancePaise   Int      @default(0) @map("balance_paise")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ledger       WalletLedgerEntry[]

  @@map("organization_wallets")
}

enum WalletLedgerType {
  topup
  sms_charge
  manual_credit
  manual_debit
  refund
}

model WalletLedgerEntry {
  id              String           @id @default(cuid())
  organizationId  String           @map("organization_id")
  type            WalletLedgerType
  amountPaise     Int              @map("amount_paise")
  balanceAfter    Int              @map("balance_after")
  referenceType   String?          @map("reference_type")
  referenceId     String?          @map("reference_id")
  note            String?
  createdByUserId String?          @map("created_by_user_id")
  createdAt       DateTime         @default(now()) @map("created_at")

  wallet OrganizationWallet @relation(fields: [organizationId], references: [organizationId], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@map("wallet_ledger_entries")
}

model Brand {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  name           String
  slug           String
  logoUrl        String?  @map("logo_url")
  isDefault      Boolean  @default(false) @map("is_default")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  outlets      Outlet[]
  settings     BrandSettings?

  @@unique([organizationId, slug])
  @@unique([id, organizationId])
  @@map("brands")
}

model BrandSettings {
  id      String @id @default(cuid())
  brandId String @unique @map("brand_id")
  settings Json  @default("{}")
  brand   Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@map("brand_settings")
}

model Outlet {
  id             String        @id @default(cuid())
  organizationId String        @map("organization_id")
  brandId        String        @map("brand_id")
  name           String
  slug           String
  code           String?
  status         OutletStatus  @default(active)
  operatingMode  OperatingMode @default(full_service) @map("operating_mode")
  address        String?
  city           String?
  zone           String?
  state          String?
  pincode        String?
  phone          String?
  email          String?
  gstin          String?
  isDefault      Boolean      @default(false) @map("is_default")
  /// Cullinos Guest marketplace discovery
  latitude            Decimal? @db.Decimal(10, 7)
  longitude           Decimal? @db.Decimal(10, 7)
  cuisineTags         String[] @default([]) @map("cuisine_tags")
  coverImageUrl       String?  @map("cover_image_url")
  marketplaceListed   Boolean  @default(false) @map("marketplace_listed")
  marketplaceFeatured Boolean  @default(false) @map("marketplace_featured")
  marketplaceFeaturedRank Int? @map("marketplace_featured_rank")
  /// pending | approved | rejected
  marketplaceModerationStatus String @default("approved") @map("marketplace_moderation_status")
  /// When true, tenant cannot re-list until platform clears
  marketplaceUnlistedByPlatform Boolean @default(false) @map("marketplace_unlisted_by_platform")
  averagePrepMinutes  Int?     @map("average_prep_minutes")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  brand           Brand            @relation(fields: [brandId, organizationId], references: [id, organizationId], onDelete: Cascade)
  settings        OutletSettings?
  floors          Floor[]
  orders          Order[]
  menuPrices      OutletMenuPrice[]
  kitchenStations KitchenStation[]
  cashierShifts   CashierShift[]
  inventoryItems  InventoryItem[]
  employees       Employee[]
  devices         Device[]
  deliveryZones   DeliveryZone[]
  rooms           Room[]
  franchiseOutlets FranchiseOutlet[]
  outletUsers      OutletUser[]
  photos           OutletPhoto[]
  events           OutletEvent[]
  productionBatches ProductionBatch[]
  aggregatorSettlements AggregatorSettlement[]
  serviceRequests   ServiceRequest[]
  guestFavorites    GuestFavoriteOutlet[]
  guestReviews      GuestOutletReview[]
  centralKitchen    CentralKitchen?
  centralKitchenLinks CentralKitchenOutlet[]
  centralKitchenIndents CentralKitchenIndent[] @relation("IndentRequestingOutlet")
  wastageRecords        Wastage[]
  reservations          Reservation[]
  reservationInvites    ReservationInvite[]
  feedbackResponses     FeedbackResponse[]
  promoDisplaySlides    PromoDisplaySlide[]

  @@unique([organizationId, slug])
  @@unique([id, organizationId])
  @@index([marketplaceListed, status])
  @@index([city])
  @@index([zone])
  @@index([state])
  @@map("outlets")
}

model OutletSettings {
  id       String @id @default(cuid())
  outletId String @unique @map("outlet_id")
  settings Json   @default("{}")
  outlet   Outlet @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@map("outlet_settings")
}

model User {
  id             String     @id @default(cuid())
  organizationId String     @map("organization_id")
  email          String
  passwordHash   String     @map("password_hash")
  name           String
  phone          String?
  status             UserStatus @default(active)
  isSuperAdmin       Boolean    @default(false) @map("is_super_admin")
  mustChangePassword Boolean    @default(false) @map("must_change_password")
  lastLoginAt        DateTime?  @map("last_login_at")
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userRoles    UserRole[]
  outletUsers  OutletUser[]
  sessions     Session[]
  auditLogs    AuditLog[]
  orders       Order[]      @relation("OrderCreatedBy")
  cashierShifts CashierShift[]
  acknowledgedServiceRequests ServiceRequest[] @relation("ServiceRequestAcknowledgedBy")

  @@unique([organizationId, email])
  @@map("users")
}

model Role {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  name           String
  slug           String
  description    String?
  isSystem       Boolean  @default(false) @map("is_system")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([organizationId, slug])
  @@map("roles")
}

model Permission {
  id          String   @id @default(cuid())
  module      String
  action      String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@unique([module, action])
  @@map("permissions")
}

model RolePermission {
  id           String @id @default(cuid())
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id     String @id @default(cuid())
  userId String @map("user_id")
  roleId String @map("role_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model OutletUser {
  id        String  @id @default(cuid())
  userId    String  @map("user_id")
  outletId  String  @map("outlet_id")
  isDefault Boolean @default(false) @map("is_default")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  outlet Outlet @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@unique([userId, outletId])
  @@map("outlet_users")
}

/// Restaurant gallery photos shown on guest outlet / menu.
model OutletPhoto {
  id        String   @id @default(cuid())
  outletId  String   @map("outlet_id")
  url       String
  caption   String?
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  outlet Outlet @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@index([outletId, sortOrder])
  @@map("outlet_photos")
}

model Session {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model ApiKey {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  name           String
  keyHash        String    @map("key_hash")
  scopes         String[]
  lastUsedAt     DateTime? @map("last_used_at")
  expiresAt      DateTime? @map("expires_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@map("api_keys")
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  userId         String?  @map("user_id")
  action         String
  entityType     String   @map("entity_type")
  entityId       String?  @map("entity_id")
  metadata       Json?
  ipAddress      String?  @map("ip_address")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@map("audit_logs")
}

// ─── Subscriptions ───────────────────────────────────────────────────────────

model Plan {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  description  String?
  priceMonthly Decimal  @default(0) @map("price_monthly") @db.Decimal(12, 2)
  priceYearly  Decimal  @default(0) @map("price_yearly") @db.Decimal(12, 2)
  maxOutlets   Int      @default(1) @map("max_outlets")
  maxTerminals Int      @default(2) @map("max_terminals")
  isActive              Boolean  @default(true) @map("is_active")
  sortOrder             Int      @default(0) @map("sort_order")
  razorpayPlanIdMonthly String?  @map("razorpay_plan_id_monthly")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  features      PlanFeature[]
  subscriptions Subscription[]

  @@map("plans")
}

model PlanFeature {
  id        String  @id @default(cuid())
  planId    String  @map("plan_id")
  module    String
  enabled   Boolean @default(true)
  limits    Json?

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, module])
  @@map("plan_features")
}

model Subscription {
  id             String             @id @default(cuid())
  organizationId String             @map("organization_id")
  planId         String             @map("plan_id")
  status         SubscriptionStatus @default(trial)
  trialEndsAt    DateTime?          @map("trial_ends_at")
  currentPeriodStart DateTime?      @map("current_period_start")
  currentPeriodEnd   DateTime?      @map("current_period_end")
  graceUntil     DateTime?          @map("grace_until")
  razorpaySubId           String?            @map("razorpay_sub_id")
  razorpayShortUrl        String?            @map("razorpay_short_url")
  lastRazorpayPaymentId   String?            @map("last_razorpay_payment_id")
  cancelledAt             DateTime?          @map("cancelled_at")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  organization  Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan          Plan                      @relation(fields: [planId], references: [id])
  entitlements  SubscriptionEntitlement[]
  usageRecords  UsageRecord[]

  @@map("subscriptions")
}

model SubscriptionEntitlement {
  id             String  @id @default(cuid())
  subscriptionId String  @map("subscription_id")
  module         String
  enabled        Boolean @default(true)
  limits         Json?

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, module])
  @@map("subscription_entitlements")
}

model UsageRecord {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  subscriptionId String?  @map("subscription_id")
  metric         String
  value          Decimal  @db.Decimal(12, 2)
  periodStart    DateTime @map("period_start")
  periodEnd      DateTime @map("period_end")
  recordedAt     DateTime @default(now()) @map("recorded_at")

  subscription Subscription? @relation(fields: [subscriptionId], references: [id])

  @@index([organizationId, metric, periodStart])
  @@map("usage_records")
}

model FeatureFlag {
  id        String  @id @default(cuid())
  key       String  @unique
  enabled   Boolean @default(false)
  metadata  Json?

  @@map("feature_flags")
}

/// Platform-wide secrets/config (super-admin). DB value overrides env when set.
model PlatformSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  valueEnc  String?  @map("value_enc")
  value     String?
  isSecret  Boolean  @default(false) @map("is_secret")
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")

  @@map("platform_settings")
}

// ─── Menu engine ─────────────────────────────────────────────────────────────

model MenuCategory {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  name           String
  slug           String
  description    String?
  imageUrl       String?  @map("image_url")
  sortOrder      Int      @default(0) @map("sort_order")
  isActive       Boolean  @default(true) @map("is_active")
  parentId       String?  @map("parent_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent       MenuCategory? @relation("CategoryTree", fields: [parentId], references: [id])
  children     MenuCategory[] @relation("CategoryTree")
  menuItems    MenuItem[]

  @@unique([organizationId, slug])
  @@map("menu_categories")
}

model MenuItem {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  categoryId     String   @map("category_id")
  name           String
  slug           String
  description    String?
  imageUrl       String?  @map("image_url")
  basePrice      Decimal  @default(0) @map("base_price") @db.Decimal(12, 2)
  taxGroupId     String?  @map("tax_group_id")
  isActive       Boolean  @default(true) @map("is_active")
  isVeg          Boolean  @default(false) @map("is_veg")
  isSpecial      Boolean  @default(false) @map("is_special")
  allergens      String[] @default([])
  sortOrder      Int      @default(0) @map("sort_order")
  sku            String?
  hsnCode        String?  @map("hsn_code")
  packagingCharge Decimal @default(0) @map("packaging_charge") @db.Decimal(12, 2)
  onlineAvailable Boolean @default(true) @map("online_available")
  stockBasedAvailability Boolean @default(false) @map("stock_based_availability")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category       MenuCategory            @relation(fields: [categoryId], references: [id])
  taxGroup       TaxGroup?               @relation(fields: [taxGroupId], references: [id])
  variants       MenuItemVariant[]
  modifierGroups MenuItemModifierGroup[]
  comboItems     ComboItem[]
  outletPrices   OutletMenuPrice[]
  orderItems     OrderItem[]
  recipe         Recipe?
  loyaltyRewards LoyaltyReward[]
  guestFavorites GuestFavoriteItem[]

  @@unique([organizationId, slug])
  @@map("menu_items")
}

model MenuItemVariant {
  id         String  @id @default(cuid())
  menuItemId String  @map("menu_item_id")
  name       String
  price      Decimal @db.Decimal(12, 2)
  sku        String?
  isDefault  Boolean @default(false) @map("is_default")
  sortOrder  Int     @default(0) @map("sort_order")

  menuItem   MenuItem    @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@map("menu_item_variants")
}

model ModifierGroup {
  id             String  @id @default(cuid())
  organizationId String  @map("organization_id")
  name           String
  minSelect      Int     @default(0) @map("min_select")
  maxSelect      Int     @default(1) @map("max_select")
  isRequired     Boolean @default(false) @map("is_required")

  modifiers    Modifier[]
  menuItems    MenuItemModifierGroup[]

  @@map("modifier_groups")
}

model Modifier {
  id              String  @id @default(cuid())
  modifierGroupId String  @map("modifier_group_id")
  name            String
  price           Decimal @default(0) @db.Decimal(12, 2)
  isDefault       Boolean @default(false) @map("is_default")
  sortOrder       Int     @default(0) @map("sort_order")

  modifierGroup ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)

  @@map("modifiers")
}

model MenuItemModifierGroup {
  id              String @id @default(cuid())
  menuItemId      String @map("menu_item_id")
  modifierGroupId String @map("modifier_group_id")

  menuItem      MenuItem      @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
