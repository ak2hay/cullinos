  @@map("webhook_deliveries")
}

model Device {
  id             String     @id @default(cuid())
  organizationId String     @map("organization_id")
  outletId       String?    @map("outlet_id")
  name           String
  type           DeviceType
  identifier     String?
  lastSeenAt     DateTime?  @map("last_seen_at")
  metadata       Json?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  outlet       Outlet?      @relation(fields: [outletId], references: [id])
  registrations DeviceRegistration[]
  printJobs     PrintJob[]

  @@map("devices")
}

model DeviceRegistration {
  id       String @id @default(cuid())
  deviceId String @map("device_id")
  token    String @unique
  platform String?

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@map("device_registrations")
}

enum PrintJobStatus {
  pending
  sent
  failed
  done
}

model PrintJob {
  id             String         @id @default(cuid())
  organizationId String         @map("organization_id")
  outletId       String?        @map("outlet_id")
  deviceId       String?        @map("device_id")
  orderId        String?        @map("order_id")
  kind           String         @default("receipt")
  status         PrintJobStatus @default(pending)
  error          String?
  payloadSummary String?        @map("payload_summary")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  device       Device?      @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@map("print_jobs")
}

model SyncEvent {
  id             String          @id @default(cuid())
  organizationId String          @map("organization_id")
  deviceId       String?         @map("device_id")
  eventType      String          @map("event_type")
  payload        Json
  idempotencyKey String          @unique @map("idempotency_key")
  status         SyncEventStatus @default(pending)
  syncedAt       DateTime?       @map("synced_at")
  createdAt      DateTime        @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@map("sync_events")
}

model SyncQueue {
  id        String   @id @default(cuid())
  deviceId  String   @map("device_id")
  payload   Json
  status    String   @default("pending")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("sync_queue")
}

model AnalyticsSnapshot {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  date           DateTime @db.Date
  metrics        Json
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, date])
  @@map("analytics_snapshots")
}

model InsightsSnapshot {
  id        String   @id @default(cuid())
  outletId  String   @map("outlet_id")
  date      DateTime @db.Date
  insights  Json
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([outletId, date])
  @@map("insights_snapshots")
}

