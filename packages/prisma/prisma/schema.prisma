  orders          Order[]
  serviceRequests ServiceRequest[]
  reservations    Reservation[]

  @@map("tables")
}

model TableSession {
  id           String             @id @default(cuid())
  tableId      String             @map("table_id")
  sessionToken String             @unique @map("session_token")
  status       TableSessionStatus @default(active)
  startedAt    DateTime           @default(now()) @map("started_at")
  endedAt      DateTime?          @map("ended_at")
  guestCount   Int?               @map("guest_count")

  table           Table            @relation(fields: [tableId], references: [id], onDelete: Cascade)
  order           Order?
  serviceRequests ServiceRequest[]

  @@index([tableId, status])
  @@map("table_sessions")
}

model ServiceRequest {
  id             String               @id @default(cuid())
  organizationId String               @map("organization_id")
  outletId       String               @map("outlet_id")
  tableId        String               @map("table_id")
  tableSessionId String?              @map("table_session_id")
  type           ServiceRequestType   @default(waiter)
  status         ServiceRequestStatus @default(open)
  note           String?
  acknowledgedById String?            @map("acknowledged_by_id")
  acknowledgedAt DateTime?            @map("acknowledged_at")
  resolvedAt     DateTime?            @map("resolved_at")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  outlet         Outlet       @relation(fields: [outletId], references: [id], onDelete: Cascade)
  table          Table        @relation(fields: [tableId], references: [id], onDelete: Cascade)
  tableSession   TableSession? @relation(fields: [tableSessionId], references: [id], onDelete: SetNull)
  acknowledgedBy User?        @relation("ServiceRequestAcknowledgedBy", fields: [acknowledgedById], references: [id], onDelete: SetNull)

  @@index([outletId, status])
  @@index([tableId, status])
  @@map("service_requests")
}

// ─── Order engine ────────────────────────────────────────────────────────────

model Order {
  id             String      @id @default(cuid())
  organizationId String      @map("organization_id")
  outletId       String      @map("outlet_id")
  orderNumber    String      @map("order_number")
  /// Customer-facing 6-char pickup / receipt code (QR ticket). Null on legacy rows.
  pickupCode     String?     @map("pickup_code")
  type           OrderType   @default(dine_in)
  source         OrderSource @default(pos)
  status         OrderStatus @default(draft)
  tableId        String?     @map("table_id")
  tableSessionId String?     @unique @map("table_session_id")
  customerId     String?     @map("customer_id")
  createdById    String?     @map("created_by_id")
  guestCount     Int?        @map("guest_count")
  notes          String?
  subtotal       Decimal     @default(0) @db.Decimal(12, 2)
  taxTotal       Decimal     @default(0) @map("tax_total") @db.Decimal(12, 2)
  discountTotal  Decimal     @default(0) @map("discount_total") @db.Decimal(12, 2)
  tipAmount      Decimal     @default(0) @map("tip_amount") @db.Decimal(12, 2)
  total          Decimal     @default(0) @db.Decimal(12, 2)
  customerName   String?     @map("customer_name")
  scheduledPickupAt DateTime? @map("scheduled_pickup_at")
  idempotencyKey String?     @unique @map("idempotency_key")
  metadata       Json?
  readyAt        DateTime?   @map("ready_at")
  completedAt    DateTime?   @map("completed_at")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  outlet       Outlet          @relation(fields: [outletId, organizationId], references: [id, organizationId])
  table        Table?          @relation(fields: [tableId], references: [id])
  tableSession TableSession?   @relation(fields: [tableSessionId], references: [id])
  customer     Customer?       @relation(fields: [customerId], references: [id])
  createdBy    User?           @relation("OrderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  items        OrderItem[]
  timeline     OrderTimeline[]
  discounts    OrderDiscount[]
  taxLines     OrderTaxLine[]
  kots         KOT[]
  payments     Payment[]
  invoices     Invoice[]
  deliveryOrder DeliveryOrder?
  guestReview          GuestOutletReview?
  feedbackResponse     FeedbackResponse?
  aggregatorSettlements  AggregatorSettlement[]

  @@unique([outletId, orderNumber])
  @@unique([outletId, pickupCode])
  @@index([organizationId, status, createdAt])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String  @map("order_id")
  menuItemId String? @map("menu_item_id")
  variantId String? @map("variant_id")
  name      String
  quantity  Int     @default(1)
  unitPrice Decimal @map("unit_price") @db.Decimal(12, 2)
  taxAmount Decimal @default(0) @map("tax_amount") @db.Decimal(12, 2)
  total     Decimal @db.Decimal(12, 2)
  notes     String?
  modifiers Json?
  status    String  @default("pending")

  order    Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem MenuItem?        @relation(fields: [menuItemId], references: [id])
  variant  MenuItemVariant? @relation(fields: [variantId], references: [id])
  kotItems KOTItem[]

  @@map("order_items")
}

model OrderTimeline {
  id        String   @id @default(cuid())
  orderId   String   @map("order_id")
  event     String
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_timeline")
}

model OrderIdempotencyKey {
  id        String   @id @default(cuid())
  key       String   @unique
  orderId   String?  @map("order_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("order_idempotency_keys")
}

model OrderDiscount {
