// ─── Food business verticals ───────────────────────────────────────────────────

model OutletEvent {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  outletId       String   @map("outlet_id")
  name           String
  location       String?
  address        String?
  latitude       Decimal? @db.Decimal(10, 7)
  longitude      Decimal? @db.Decimal(10, 7)
  eventDate      DateTime @map("event_date")
  startTime      String   @map("start_time")
  endTime        String   @map("end_time")
  preOrderOpensAt DateTime? @map("pre_order_opens_at")
  preOrderClosesAt DateTime? @map("pre_order_closes_at")
  maxPreOrders   Int?     @map("max_pre_orders")
  notes          String?
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  outlet       Outlet       @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@index([outletId, eventDate])
  @@map("outlet_events")
}

model ProductionBatch {
  id             String                @id @default(cuid())
  organizationId String                @map("organization_id")
  outletId       String                @map("outlet_id")
  recipeId       String?               @map("recipe_id")
  name           String
  plannedQty     Decimal               @map("planned_qty") @db.Decimal(12, 2)
  actualQty      Decimal?              @map("actual_qty") @db.Decimal(12, 2)
  scaleFactor    Decimal               @default(1) @map("scale_factor") @db.Decimal(8, 2)
  status         ProductionBatchStatus @default(planned)
  batchNumber    String?               @map("batch_number")
  scheduledFor   DateTime              @map("scheduled_for")
  completedAt    DateTime?             @map("completed_at")
  notes          String?
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  outlet       Outlet       @relation(fields: [outletId], references: [id], onDelete: Cascade)
  recipe       Recipe?      @relation(fields: [recipeId], references: [id])

  @@index([outletId, scheduledFor])
  @@map("production_batches")
}

model EmailOtp {
  id             String          @id @default(cuid())
  email          String
  userId         String?         @map("user_id")
  purpose        EmailOtpPurpose
  codeHash       String          @map("code_hash")
  challengeToken String          @unique @map("challenge_token")
  attempts       Int             @default(0)
  expiresAt      DateTime        @map("expires_at")
  consumedAt     DateTime?       @map("consumed_at")
  createdAt      DateTime        @default(now()) @map("created_at")

  @@index([email, purpose])
  @@index([challengeToken])
  @@map("email_otps")
}

model PhoneOtp {
  id             String   @id @default(cuid())
  phone          String
  organizationId String   @map("organization_id")
  codeHash       String   @map("code_hash")
  challengeToken String   @unique @map("challenge_token")
  attempts       Int      @default(0)
  expiresAt      DateTime @map("expires_at")
  consumedAt     DateTime? @map("consumed_at")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([phone, organizationId])
  @@index([challengeToken])
  @@map("phone_otps")
}

model EmailCampaign {
  id               String              @id @default(cuid())
  scope            EmailCampaignScope
  organizationId   String?             @map("organization_id")
  createdByUserId  String              @map("created_by_user_id")
  subject          String
  body             String
  recipientCount   Int                 @default(0) @map("recipient_count")
  sentCount        Int                 @default(0) @map("sent_count")
  failedCount      Int                 @default(0) @map("failed_count")
  status           EmailCampaignStatus @default(sending)
  createdAt        DateTime            @default(now()) @map("created_at")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@map("email_campaigns")
}

/// DPDP consent / notice acknowledgment registry (purpose-tagged, withdrawable).
model ConsentRecord {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  subjectType    String    @map("subject_type")
  subjectId      String    @map("subject_id")
  purpose        String
  noticeVersion  String    @map("notice_version")
  granted        Boolean
  source         String
  ipAddress      String?   @map("ip_address")
  createdAt      DateTime  @default(now()) @map("created_at")
  withdrawnAt    DateTime? @map("withdrawn_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, subjectType, subjectId])
  @@index([purpose, granted])
  @@map("consent_records")
}

/// Opaque short-lived handoff so impersonation JWTs are not placed in URLs.
model ImpersonationHandoff {
  id               String    @id @default(cuid())
  organizationId   String    @map("organization_id")
  createdByUserId  String    @map("created_by_user_id")
  targetUserId     String    @map("target_user_id")
  codeHash         String    @unique @map("code_hash")
  accessToken      String    @map("access_token")
  reason           String
  expiresAt        DateTime  @map("expires_at")
  consumedAt       DateTime? @map("consumed_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("impersonation_handoffs")
}

// ─── Phase 5 Growth ──────────────────────────────────────────────────────────

model Reservation {
  id             String            @id @default(cuid())
  organizationId String            @map("organization_id")
  outletId       String            @map("outlet_id")
  customerName   String            @map("customer_name")
  customerPhone  String            @map("customer_phone")
  customerEmail  String?           @map("customer_email")
  partySize      Int               @map("party_size")
  reservedAt     DateTime          @map("reserved_at")
  tableId        String?           @map("table_id")
  status         ReservationStatus @default(pending)
  notes          String?
  bookingToken   String            @unique @map("booking_token")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  outlet       Outlet       @relation(fields: [outletId], references: [id], onDelete: Cascade)
  table        Table?       @relation(fields: [tableId], references: [id], onDelete: SetNull)
  invite       ReservationInvite?

  @@index([outletId, reservedAt])
  @@index([organizationId, status])
  @@map("reservations")
}

model ReservationInvite {
  id             String                  @id @default(cuid())
  organizationId String                  @map("organization_id")
  outletId       String                  @map("outlet_id")
  customerName   String                  @map("customer_name")
  customerPhone  String                  @map("customer_phone")
  customerEmail  String?                 @map("customer_email")
  token          String                  @unique
  status         ReservationInviteStatus @default(sent)
  expiresAt      DateTime                @map("expires_at")
  reservationId  String?                 @unique @map("reservation_id")
  createdAt      DateTime                @default(now()) @map("created_at")
  updatedAt      DateTime                @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  outlet       Outlet       @relation(fields: [outletId], references: [id], onDelete: Cascade)
  reservation  Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)

  @@index([outletId, status])
  @@index([organizationId, createdAt])
  @@map("reservation_invites")
}

model SmsCampaign {
