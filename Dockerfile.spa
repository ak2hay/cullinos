# syntax=docker/dockerfile:1
# Build a single Vite SPA or static landing into an nginx image.
# Usage:
#   docker build -f Dockerfile.spa --build-arg APP_NAME=admin -t cullinos-spa-admin .
#   docker build -f Dockerfile.spa --build-arg APP_NAME=guest-landing -t cullinos-spa-guest-landing .
# APP_NAME: admin | management | super-admin | app-ops | pos | kds | kiosk | guest-landing | waiter-landing

ARG APP_NAME=admin

FROM node:22-alpine AS builder

ARG APP_NAME
ARG VITE_API_URL=https://api.cullinos.com/api/v1
ARG VITE_WS_URL=https://api.cullinos.com
ARG VITE_KDS_URL=https://kds.cullinos.com
ARG VITE_POS_URL=https://pos.cullinos.com
ARG VITE_GUEST_APP_URL=https://guest.cullinos.com
ARG VITE_KIOSK_APP_URL=https://kiosk.cullinos.com
ARG VITE_ADMIN_URL=https://admin.cullinos.com
ARG VITE_PLATFORM_URL=https://platform.cullinos.com
ARG VITE_APP_OPS_URL=https://app.cullinos.com
ARG VITE_MARKETING_WEB_URL=https://cullinos.com
ARG VITE_TURNSTILE_SITE_KEY=

WORKDIR /app

RUN apk add --no-cache openssl

ENV VITE_API_URL=$VITE_API_URL \
    VITE_WS_URL=$VITE_WS_URL \
    VITE_KDS_URL=$VITE_KDS_URL \
    VITE_POS_URL=$VITE_POS_URL \
    VITE_GUEST_APP_URL=$VITE_GUEST_APP_URL \
    VITE_KIOSK_APP_URL=$VITE_KIOSK_APP_URL \
    VITE_ADMIN_URL=$VITE_ADMIN_URL \
    VITE_PLATFORM_URL=$VITE_PLATFORM_URL \
    VITE_APP_OPS_URL=$VITE_APP_OPS_URL \
    VITE_MARKETING_WEB_URL=$VITE_MARKETING_WEB_URL \
    VITE_TURNSTILE_SITE_KEY=$VITE_TURNSTILE_SITE_KEY

COPY package.json package-lock.json .npmrc ./
COPY apps ./apps
COPY packages ./packages
COPY turbo.json tsconfig.base.json ./
COPY infrastructure/www ./infrastructure/www

# Landings are static HTML — skip npm build
# SPA builds must bake VITE_API_URL (Chrome blocks loopback → "Failed to fetch")
ARG ANDROID_ASSETLINKS_SHA256=
# Production (main) builds must set this to true; staging tolerates a placeholder assetlinks.json
ARG REQUIRE_ASSETLINKS=false
RUN if [ "$APP_NAME" = "guest-landing" ] || [ "$APP_NAME" = "waiter-landing" ]; then \
      mkdir -p /out && cp -r "infrastructure/www/${APP_NAME}/." /out/ \
      && if [ -f /out/.well-known/assetlinks.json ]; then \
           if [ -z "$ANDROID_ASSETLINKS_SHA256" ]; then \
             if [ "$REQUIRE_ASSETLINKS" = "true" ]; then \
               echo "ERROR: ANDROID_ASSETLINKS_SHA256 is empty; App Links would never verify" >&2; exit 1; \
             fi; \
             echo "WARNING: ANDROID_ASSETLINKS_SHA256 is empty; leaving placeholder assetlinks.json" >&2; \
           else \
             FPS="$(echo "$ANDROID_ASSETLINKS_SHA256" | tr ',' '\n' | sed '/^$/d; s/.*/"&"/' | paste -sd, -)"; \
             sed -i "s|\"REPLACE_WITH_PLAY_OR_UPLOAD_CERT_SHA256\"|${FPS}|" /out/.well-known/assetlinks.json; \
           fi; \
         fi; \
    else \
      if [ -z "$VITE_API_URL" ]; then echo "ERROR: VITE_API_URL is empty" >&2; exit 1; fi \
        && npm ci --include=dev \
        && npm run build -w @cullinos/shared -w @cullinos/ui \
        && npm run build -w "@cullinos/${APP_NAME}" \
        && if ! grep -rqF "$VITE_API_URL" "apps/${APP_NAME}/dist"; then \
             echo "ERROR: apps/${APP_NAME}/dist does not contain VITE_API_URL=$VITE_API_URL" >&2; \
             exit 1; \
           fi \
        && mkdir -p /out && cp -r "apps/${APP_NAME}/dist/." /out/; \
    fi

FROM nginxinc/nginx-unprivileged:1.27-alpine AS runner

ARG APP_NAME
LABEL org.opencontainers.image.title="cullinos-spa-${APP_NAME}"

COPY docker/spa-nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /out /usr/share/nginx/html

USER 101

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget -qO- http://127.0.0.1:8080/ >/dev/null || exit 1

CMD ["nginx", "-g", "daemon off;"]
