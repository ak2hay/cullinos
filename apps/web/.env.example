NEXT_PUBLIC_SITE_URL=https://cullinos.com
NEXT_PUBLIC_ADMIN_URL=https://admin.cullinos.com
NEXT_PUBLIC_REGISTER_URL=https://admin.cullinos.com/register
NEXT_PUBLIC_API_URL=http://localhost:3000/api
REVALIDATE_SECRET=change-me-revalidate-secret
RESEND_API_KEY=
CONTACT_TO_EMAIL=cullinos@rkyves.com
CONTACT_FROM_EMAIL=onboarding@resend.dev
# Telegram notifications for contact-form enquiries (server-only; never use NEXT_PUBLIC_).
# TELEGRAM_CHAT_ID: your user id, or a negative id (-100...) for a group/channel the bot is in.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Cloudflare Turnstile (https://dash.cloudflare.com → Turnstile). Leave empty to skip in local dev.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Same value as the API's INTERNAL_API_KEY; lets /api/contact forward captcha-verified inquiries
INTERNAL_API_KEY=
# Cloudflare Web Analytics token (Analytics → Web Analytics → Manage site)
NEXT_PUBLIC_CF_WEB_ANALYTICS_TOKEN=
