# Example secret keys for PRODUCTION_APP_SECRETS_ENV / STAGING_APP_SECRETS_ENV
# (GitHub Actions secret: multiline KEY=value — never commit filled values)
#
# POSTGRES_PASSWORD=...
# DATABASE_URL=postgresql://cullinos:...@postgres:5432/cullinos
# JWT_SECRET=...
# JWT_REFRESH_SECRET=...
# SUPER_ADMIN_JWT_SECRET=...
# ENCRYPTION_KEY=...
# INTERNAL_API_KEY=...
# SENTRY_DSN=https://...@o....ingest.sentry.io/...
# SENTRY_ENVIRONMENT=production
# FIREBASE_PROJECT_ID=...
# FIREBASE_SERVICE_ACCOUNT_JSON=...
# RAZORPAY_KEY_ID=...
# ...
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://cullinos:change-me@postgres:5432/cullinos
JWT_SECRET=change-me-min-32-chars-xxxxxxxxxx
JWT_REFRESH_SECRET=change-me-min-32-chars-xxxxxxxxxx
SUPER_ADMIN_JWT_SECRET=change-me-min-32-chars-xxxxxxxxxx
ENCRYPTION_KEY=change-me-32-byte-hex-or-passphrase
INTERNAL_API_KEY=change-me-internal-key
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
