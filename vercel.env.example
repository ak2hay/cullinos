# =============================================================================
# Cullinos — Vercel environment variables (frontends only)
# =============================================================================
# No API secrets here — JWT/DB keys stay on Railway only.
#
# How to import on Vercel:
#   Project → Settings → Environment Variables → "Import .env" (or paste Raw)
#   Enable: Production, Preview, Development
#
# After api.cullinos.com DNS is live (required for production frontends):
VITE_API_URL=https://api.cullinos.com/api/v1
# =============================================================================
