# Production environment for docker-compose.prod.yml (VM only — no external DB/Redis)
# Copy to .env on the server: cp .env.production.example .env && fill secrets

NODE_ENV=production
API_PORT=3000

# Postgres (must match docker-compose.prod.yml POSTGRES_PASSWORD)
POSTGRES_PASSWORD=change-me-strong-password
DATABASE_URL=postgresql://cullinos:change-me-strong-password@postgres:5432/cullinos

REDIS_URL=redis://redis:6379

JWT_SECRET=change-me-min-32-chars
JWT_REFRESH_SECRET=change-me-min-32-chars
SUPER_ADMIN_JWT_SECRET=change-me-min-32-chars
# Firebase Admin — Guest Firebase Auth → Nest guest JWT (required for Guest app prod)
FIREBASE_PROJECT_ID=rkyves-cullinos
# Prefer JSON in .env on the VM (single line). Generate: Firebase Console → Project settings → Service accounts → Generate new private key
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"rkyves-cullinos",...}
# Or mount a file and set:
# FIREBASE_SERVICE_ACCOUNT_PATH=/secrets/firebase-adminsdk.json
# Or base64 of the JSON file (handy for secret managers):
# FIREBASE_SERVICE_ACCOUNT_BASE64=
# Used to encrypt platform secrets saved via super-admin Settings (AES-256-GCM).
# Accepts 64-char hex (32 bytes) or any passphrase (scrypt-derived).
ENCRYPTION_KEY=change-me-32-byte-hex
INTERNAL_API_KEY=change-me-internal-provision-key

# Error monitoring (Sentry free tier) — also set in k8s cullinos-secrets
# SENTRY_DSN=https://...@o....ingest.sentry.io/...
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.05

API_URL=https://api.cullinos.com
GUEST_APP_URL=https://guest.cullinos.com
WAITER_APP_URL=https://play.google.com/store/apps/details?id=com.cullinos.waiter
# Deprecated — prefer GUEST_APP_URL
CUSTOMER_APP_URL=https://order.cullinos.com
ADMIN_APP_URL=https://admin.cullinos.com
MARKETING_SITE_URL=https://cullinos.com
# waiter.cullinos.com serves the Waiter Android landing page (not an SPA origin)
CORS_ORIGINS=https://admin.cullinos.com,https://manage.cullinos.com,https://platform.cullinos.com,https://guest.cullinos.com,https://pos.cullinos.com,https://kds.cullinos.com,https://cullinos.com

# DPDP retention defaults (optional)
# PRIVACY_OTP_RETENTION_DAYS=7
# PRIVACY_HANDOFF_RETENTION_HOURS=24
# PRIVACY_INACTIVE_CUSTOMER_DAYS=1095

# Baked into Vite SPAs by scripts/build-frontends.sh (override only if domains differ)
# VITE_API_URL=https://api.cullinos.com/api/v1
# VITE_WS_URL=https://api.cullinos.com
# VITE_GUEST_APP_URL=https://guest.cullinos.com
VITE_CUSTOMER_URL=https://order.cullinos.com
# VITE_KDS_URL=https://kds.cullinos.com
# VITE_POS_URL=https://pos.cullinos.com
# Super-admin support handoff into tenant admin
ADMIN_URL=https://admin.cullinos.com
# VITE_ADMIN_URL=https://admin.cullinos.com
# VITE_SUPER_ADMIN_URL=https://platform.cullinos.com

# Cloudflare R2 (preferred for CMS uploads). When set, marketing files go to R2 instead of the Docker volume.
# Set R2_PUBLIC_URL to your custom CDN domain or r2.dev public URL (no trailing slash).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
# R2_ENDPOINT=

# Daily backups + rollback (private bucket — do NOT use the public CMS bucket)
# See docs/BACKUP_ROLLBACK.md
R2_BACKUP_BUCKET=cullinos-backups
# R2_BACKUP_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
BACKUP_LOCAL_DIR=/var/backups/cullinos
# 0 = R2-only (delete local pack after successful upload). Set >0 to keep N days on disk.
BACKUP_KEEP_LOCAL_DAYS=0
BACKUP_KEEP_R2_DAYS=30
RELEASE_KEEP_COUNT=5
# weekly = docker save only on Sunday UTC; always|never also supported
BACKUP_INCLUDE_IMAGES=weekly
# R2 hourly retention only (local hourly file is deleted after upload)
BACKUP_HOURLY_KEEP_HOURS=72
# Slack/Discord webhook — notified on backup failure (set BACKUP_ALERT_ON=always for success too)
# BACKUP_ALERT_WEBHOOK=
# BACKUP_ALERT_ON=fail

# Local disk fallback only when R2_* is unset (Docker volume cullinos_marketing_uploads).
# Prefer R2 in production. If using local disk, set absolute public URL so admin/guest can load images:
# API_PUBLIC_URL=https://api.cullinos.com
# MARKETING_PUBLIC_URL=https://api.cullinos.com/cms
MARKETING_UPLOAD_DIR=/data/marketing-uploads
API_PUBLIC_URL=https://api.cullinos.com
REVALIDATE_SECRET=change-me-revalidate-secret
MARKETING_REVALIDATE_URL=https://cullinos.com/api/revalidate

# Marketing site (apps/web Docker) — Turnstile + Cloudflare Web Analytics
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_CF_WEB_ANALYTICS_TOKEN=
# Same Turnstile secret is used by the Nest API for portal/app login captcha.
# Vite portals need the matching public site key:
VITE_TURNSTILE_SITE_KEY=
CONTACT_TO_EMAIL=hello@rkyves.com
CONTACT_FROM_EMAIL=

# Must remain false/unset in production — API refuses to start if enabled.
AUTH_SKIP_EMAIL_OTP=false

# Platform Razorpay — Cullinos SaaS subscriptions only.
# Restaurant diner payments: Admin → Payments (per-tenant Razorpay / Cashfree; needs ENCRYPTION_KEY).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
OPENAI_API_KEY=

# MSG91 — OTP Widget (preferred). Auth key server-only; widget id + tokenAuth for client bootstrap.
MSG91_AUTH_KEY=
MSG91_WIDGET_ID=
MSG91_WIDGET_TOKEN=
MSG91_SENDER_ID=CULLIN
MSG91_TEMPLATE_ID=
MSG91_OTP_TTL_SECONDS=300
# Portal wallet SMS rate (paise per 100 SMS). Prefer Super Admin platform settings.
# SMS_PRICE_PER_100_PAISE=10000
