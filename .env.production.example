# Production environment for docker-compose.prod.yml (VM only — no external DB/Redis)
# Copy to .env on the server: cp .env.production.example .env && fill secrets

NODE_ENV=production
API_PORT=3000

# Postgres (must match docker-compose.prod.yml POSTGRES_PASSWORD)
POSTGRES_PASSWORD=change-me-strong-password
DATABASE_URL=postgresql://cullinos:change-me-strong-password@postgres:5432/cullinos

REDIS_URL=redis://redis:6379

JWT_SECRET=change-me-min-32-chars
JWT_REFRESH_SECRET=change-me-min-32-chars
SUPER_ADMIN_JWT_SECRET=change-me-min-32-chars
# Used to encrypt platform secrets saved via super-admin Settings (AES-256-GCM).
# Accepts 64-char hex (32 bytes) or any passphrase (scrypt-derived).
ENCRYPTION_KEY=change-me-32-byte-hex
INTERNAL_API_KEY=change-me-internal-provision-key

API_URL=https://api.cullinos.com
CUSTOMER_APP_URL=https://order.cullinos.com
CORS_ORIGINS=https://admin.cullinos.com,https://manage.cullinos.com,https://platform.cullinos.com,https://order.cullinos.com,https://waiter.cullinos.com,https://pos.cullinos.com,https://kds.cullinos.com,https://cullinos.com

# Baked into Vite SPAs by scripts/build-frontends.sh (override only if domains differ)
# VITE_API_URL=https://api.cullinos.com/api/v1
# VITE_WS_URL=https://api.cullinos.com
# VITE_CUSTOMER_URL=https://order.cullinos.com
# VITE_KDS_URL=https://kds.cullinos.com
# VITE_POS_URL=https://pos.cullinos.com
# Super-admin support handoff into tenant admin
ADMIN_URL=https://admin.cullinos.com
# VITE_ADMIN_URL=https://admin.cullinos.com
# VITE_SUPER_ADMIN_URL=https://platform.cullinos.com

# Cloudflare R2 (preferred for CMS uploads). When set, marketing files go to R2 instead of the Docker volume.
# Set R2_PUBLIC_URL to your custom CDN domain or r2.dev public URL (no trailing slash).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
# R2_ENDPOINT=

# Local disk fallback only when R2_* is unset (Docker volume cullinos_marketing_uploads)
MARKETING_UPLOAD_DIR=/data/marketing-uploads
REVALIDATE_SECRET=change-me-revalidate-secret
MARKETING_REVALIDATE_URL=https://cullinos.com/api/revalidate

# Marketing site (apps/web Docker) — Turnstile + Cloudflare Web Analytics
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_CF_WEB_ANALYTICS_TOKEN=
CONTACT_TO_EMAIL=hello@rkyves.com
CONTACT_FROM_EMAIL=

# Temporary: password-only Admin/Super Admin login (skip email OTP). Set false when SMTP works.
AUTH_SKIP_EMAIL_OTP=true

# Optional — diner POS + Cullinos subscriptions
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
OPENAI_API_KEY=

# MSG91 SMS (customer phone OTP). If unset, OTP is logged server-side (non-prod may return debugOtp).
MSG91_AUTH_KEY=
MSG91_SENDER_ID=CULLIN
MSG91_TEMPLATE_ID=
MSG91_OTP_TTL_SECONDS=300
