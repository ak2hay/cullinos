# Database
DATABASE_URL="postgresql://user:pass@host/neondb?sslmode=require"

# Redis (Upstash)
REDIS_URL="rediss://default:token@host.upstash.io:6379"

# JWT (restaurant users) — generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET="generate-64-char-hex"
JWT_REFRESH_SECRET="generate-64-char-hex"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Super Admin JWT (separate realm)
SUPER_ADMIN_JWT_SECRET="generate-64-char-hex"

# API
API_PORT=3000
API_URL="https://api.cullinos.com"
NODE_ENV="production"

# Production CORS (comma-separated, no spaces)
CORS_ORIGINS="https://admin.cullinos.com,https://manage.cullinos.com,https://platform.cullinos.com,https://order.cullinos.com,https://waiter.cullinos.com"

# Frontend URLs (production)
ADMIN_URL="https://admin.cullinos.com"
MANAGEMENT_URL="https://manage.cullinos.com"
SUPER_ADMIN_URL="https://platform.cullinos.com"
CUSTOMER_URL="https://order.cullinos.com"
WAITER_URL="https://waiter.cullinos.com"

# Vercel (set in each project dashboard)
VITE_API_URL="https://api.cullinos.com/api/v1"
VITE_WS_URL="https://api.cullinos.com"

# Encryption key (32 bytes hex = 64 characters)
ENCRYPTION_KEY="generate-64-char-hex"

# Razorpay (optional)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
