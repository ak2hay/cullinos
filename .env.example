# Database
DATABASE_URL=postgresql://cullinos:cullinos@localhost:5433/cullinos

# Redis
REDIS_URL=redis://localhost:6380

# API
API_PORT=3000
JWT_SECRET=change-me-in-production-min-32-chars
JWT_EXPIRES_IN=7d
# Optional error monitoring (no-op when unset)
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=development

# Firebase Admin (Guest app Auth → Nest guest JWT exchange)
# Project: rkyves-cullinos
# Console → Project settings → Service accounts → Generate new private key
FIREBASE_PROJECT_ID=rkyves-cullinos
# Prefer a file path (do not commit the JSON):
# FIREBASE_SERVICE_ACCOUNT_PATH=C:/secrets/rkyves-cullinos-firebase-adminsdk.json
# Or inline JSON (escape carefully):
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
INTERNAL_API_KEY=change-me-internal-provision-key
# Comma-separated browser origins allowed for credentialed CORS / Socket.IO.
# Required in production. Local defaults apply when unset in non-production.
# CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5176
# Used to encrypt platform secrets stored via super-admin Settings (AES-256-GCM).
# Accepts 64-char hex (32 bytes) or any passphrase (scrypt-derived).
ENCRYPTION_KEY=change-me-32-byte-hex

# Owner onboarding email (Resend). If unset, credentials are logged and returned in the API response only.
RESEND_API_KEY=
MAIL_FROM_EMAIL=onboarding@resend.dev

# Brevo SMTP (OTP + promotional email). If unset, emails are logged and not sent.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Cullinos
# Marketing / broadcast From (prefer news.yourdomain.com). Falls back to SMTP_FROM_EMAIL.
SMTP_MARKETING_FROM_EMAIL=
SMTP_MARKETING_FROM_NAME=
# Dev-only permanent skip (legacy). Prefer Super Admin → Email OTP timed disable.
# Blocked in production (API will not start if true).
AUTH_SKIP_EMAIL_OTP=true
# Timed email/SMS OTP disable windows (ISO-8601 until). Usually set via Super Admin UI.
# AUTH_EMAIL_OTP_DISABLED_UNTIL=
# AUTH_SMS_OTP_DISABLED_UNTIL=

# Cloudflare R2 object storage (optional locally; preferred in production for CMS uploads)
# Create an R2 bucket, enable public access (r2.dev URL) or attach a custom domain, then set R2_PUBLIC_URL.
# Example public URLs: https://pub-xxxxx.r2.dev  or  https://cdn.example.com
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
# R2_ENDPOINT=   # optional override; defaults to https://{R2_ACCOUNT_ID}.r2.cloudflarestorage.com
# Also set R2_PUBLIC_URL (or NEXT_PUBLIC_R2_PUBLIC_URL) for the Next.js marketing app image allowlist.

# Marketing CMS (local disk fallback when R2_* is unset)
MARKETING_UPLOAD_DIR=
# Absolute public base for local CMS uploads (optional). Prefer R2_* in production.
# API_PUBLIC_URL=http://localhost:3000
MARKETING_PUBLIC_URL=http://localhost:3000/cms
MARKETING_REVALIDATE_URL=http://localhost:5180/api/revalidate
REVALIDATE_SECRET=change-me-revalidate-secret
OPENAI_API_KEY=

# Marketing site (apps/web) — see apps/web/.env.example
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# NEXT_PUBLIC_CF_WEB_ANALYTICS_TOKEN=

# Auth captcha (Cloudflare Turnstile) — shared by Nest API + Vite portals + Flutter apps
# API verifies with TURNSTILE_SECRET_KEY (skip verify in local when unset)
# TURNSTILE_SECRET_KEY=
# Vite apps (admin, pos, kds, management, super-admin):
# VITE_TURNSTILE_SITE_KEY=
# Flutter guest/waiter: pass --dart-define=TURNSTILE_SITE_KEY=...

# Rkyves integration
RKYVES_WEBHOOK_URL=http://localhost:3000/api/webhooks/cullinos
RKYVES_WEBHOOK_SECRET=change-me-webhook-secret

# MSG91 SMS — OTP Widget (preferred) + optional Flow SMS fallback.
# Guest app phone login uses API OTP via MSG91 (not Firebase SMS) for India (+91).
# Auth key is SERVER-ONLY (verifyAccessToken). Widget ID + tokenAuth are served to the client via /public/auth/otp/widget-config.
# Never put MSG91_AUTH_KEY in Vite/frontend env.
MSG91_AUTH_KEY=
MSG91_WIDGET_ID=
MSG91_WIDGET_TOKEN=
MSG91_SENDER_ID=CULLIN
MSG91_TEMPLATE_ID=
MSG91_MARKETING_TEMPLATE_ID=
MSG91_OTP_TTL_SECONDS=300
# Portal wallet: SMS campaign price per 100 messages in paise (10000 = ₹100 / 100 SMS).
# Prefer setting via Super Admin → Platform Settings → Portal wallet & SMS pricing.
# SMS_PRICE_PER_100_PAISE=10000
# Dev: return OTP in API JSON when SMS cannot be sent (local/log provider)
# GUEST_OTP_DEBUG_IN_PROD=true

# Frontend app URLs (admin portal embeds / launches)
# Local: leave unset or use localhost. Production builds (scripts/build-frontends.sh) default to:
#   VITE_GUEST_APP_URL=https://guest.cullinos.com
VITE_CUSTOMER_URL=https://order.cullinos.com
#   VITE_POS_URL=https://pos.cullinos.com
#   VITE_KDS_URL=https://kds.cullinos.com
# When admin Vite points at the VM API (VITE_API_URL=https://api.cullinos.com/...), set:
#   VITE_GUEST_APP_URL=https://guest.cullinos.com
VITE_CUSTOMER_URL=https://order.cullinos.com
# VITE_POS_URL=http://localhost:5173
# VITE_KDS_URL=http://localhost:5174
# VITE_GUEST_APP_URL=https://guest.cullinos.com
# WAITER_APP_URL=https://play.google.com/store/apps/details?id=com.cullinos.waiter
VITE_CUSTOMER_URL=http://localhost:5176
# MARKETING_SITE_URL=http://localhost:5180
# Used for promo unsubscribe links (defaults to https://cullinos.com)
# MARKETING_SITE_URL=https://cullinos.com

# DPDP privacy retention (optional; defaults shown)
# PRIVACY_OTP_RETENTION_DAYS=7
# PRIVACY_HANDOFF_RETENTION_HOURS=24
# PRIVACY_INACTIVE_CUSTOMER_DAYS=1095
# Super-admin ↔ admin support handoff
# ADMIN_URL=http://localhost:5173
# VITE_ADMIN_URL=http://localhost:5173
# VITE_SUPER_ADMIN_URL=http://localhost:5183

# Razorpay — Cullinos SaaS subscription billing only (platform merchant).
# Diner / POS / Guest online payments use each restaurant's own Razorpay or Cashfree
# credentials configured in Admin → Payments (stored encrypted; requires ENCRYPTION_KEY).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Optional Vite fallback for SaaS billing UI only (KEY_ID — never put KEY_SECRET in frontend).
# Diner checkout always uses keyId / paymentSessionId from POST /api/v1/payments/online/intent.
# VITE_RAZORPAY_KEY_ID=
# Platform SaaS webhook: POST {API}/api/v1/payments/webhooks/razorpay
# Per-restaurant diner webhooks use the same paths; signatures are verified with that tenant's secret.
# Cashfree diner webhook: POST {API}/api/v1/payments/webhooks/cashfree

# Cullinos Guest app push + release controls
FCM_SERVER_KEY=
GUEST_APP_MIN_VERSION=1
GUEST_APP_FORCE_UPDATE=false
# GUEST_APP_SOFT_UPDATE_MESSAGE=
# GUEST_APP_MAINTENANCE=
# GUEST_APP_PLAY_STORE_URL=
# GUEST_APP_SUPPORT_URL=
# GUEST_APP_PRIVACY_URL=
# GUEST_APP_TERMS_URL=
# GUEST_APP_FEATURE_FLAGS={}

GUEST_APP_URL=https://guest.cullinos.com
