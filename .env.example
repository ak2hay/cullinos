# Database
DATABASE_URL=postgresql://cullinos:cullinos@localhost:5433/cullinos

# Redis
REDIS_URL=redis://localhost:6380

# API
API_PORT=3000
JWT_SECRET=change-me-in-production-min-32-chars
JWT_EXPIRES_IN=7d
INTERNAL_API_KEY=change-me-internal-provision-key
# Used to encrypt platform secrets stored via super-admin Settings (AES-256-GCM).
# Accepts 64-char hex (32 bytes) or any passphrase (scrypt-derived).
ENCRYPTION_KEY=change-me-32-byte-hex

# Owner onboarding email (Resend). If unset, credentials are logged and returned in the API response only.
RESEND_API_KEY=
MAIL_FROM_EMAIL=onboarding@resend.dev

# Brevo SMTP (OTP + promotional email). If unset, emails are logged and not sent.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Cullinos
# Temporary: password-only Admin/Super Admin login (skip email OTP). Set false when SMTP works.
AUTH_SKIP_EMAIL_OTP=true

# Cloudflare R2 object storage (optional locally; preferred in production for CMS uploads)
# Create an R2 bucket, enable public access (r2.dev URL) or attach a custom domain, then set R2_PUBLIC_URL.
# Example public URLs: https://pub-xxxxx.r2.dev  or  https://cdn.example.com
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
# R2_ENDPOINT=   # optional override; defaults to https://{R2_ACCOUNT_ID}.r2.cloudflarestorage.com
# Also set R2_PUBLIC_URL (or NEXT_PUBLIC_R2_PUBLIC_URL) for the Next.js marketing app image allowlist.

# Marketing CMS (local disk fallback when R2_* is unset)
MARKETING_UPLOAD_DIR=
MARKETING_PUBLIC_URL=/cms
MARKETING_REVALIDATE_URL=http://localhost:5180/api/revalidate
REVALIDATE_SECRET=change-me-revalidate-secret
OPENAI_API_KEY=

# Marketing site (apps/web) — see apps/web/.env.example
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# NEXT_PUBLIC_CF_WEB_ANALYTICS_TOKEN=

# Rkyves integration
RKYVES_WEBHOOK_URL=http://localhost:3000/api/webhooks/cullinos
RKYVES_WEBHOOK_SECRET=change-me-webhook-secret

# MSG91 SMS (customer phone OTP). If unset, OTP is logged server-side (non-prod may return debugOtp).
MSG91_AUTH_KEY=
MSG91_SENDER_ID=CULLIN
MSG91_TEMPLATE_ID=
MSG91_OTP_TTL_SECONDS=300

# Frontend app URLs (admin portal embeds / launches)
# Local: leave unset or use localhost. Production builds (scripts/build-frontends.sh) default to:
#   VITE_CUSTOMER_URL=https://order.cullinos.com
#   VITE_POS_URL=https://pos.cullinos.com
#   VITE_KDS_URL=https://kds.cullinos.com
# When admin Vite points at the VM API (VITE_API_URL=https://api.cullinos.com/...), set:
#   VITE_CUSTOMER_URL=https://order.cullinos.com
# VITE_POS_URL=http://localhost:5173
# VITE_KDS_URL=http://localhost:5174
# VITE_CUSTOMER_URL=http://localhost:5176
# Super-admin ↔ admin support handoff
# ADMIN_URL=http://localhost:5173
# VITE_ADMIN_URL=http://localhost:5173
# VITE_SUPER_ADMIN_URL=http://localhost:5183

# Razorpay (diner POS + Cullinos subscriptions)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Webhook URL: POST {API}/api/v1/payments/webhooks/razorpay
