# Production E2E — copy to e2e/.env.local and fill in real values.
# Never commit e2e/.env.local.

# App URLs
E2E_API_URL=https://api.cullinos.com
E2E_WEB_URL=https://cullinos.com
E2E_ADMIN_URL=https://admin.cullinos.com
E2E_MANAGEMENT_URL=https://manage.cullinos.com
E2E_SUPER_ADMIN_URL=https://platform.cullinos.com
E2E_CUSTOMER_URL=https://order.cullinos.com
E2E_WAITER_URL=https://waiter.cullinos.com

# POS/KDS are local gateway apps — skipped by default in cloud E2E
E2E_SKIP_POS=true
E2E_POS_URL=
E2E_KDS_URL=

# Test tenant — leave blank to auto-discover via global setup
E2E_ORG_SLUG=
E2E_OUTLET_SLUG=main-outlet
E2E_OUTLET_ID=

# Auto-provision sandbox tenant when discovery fails (requires deployed POST /super-admin/organizations)
E2E_AUTO_PROVISION=false

# Super admin (production)
E2E_SUPER_ADMIN_EMAIL=admin@rkyves.com
E2E_SUPER_ADMIN_PASSWORD=superadmin123

# Owner used for login tests — set explicitly or let auto-provision create this account
E2E_OWNER_EMAIL=e2e-owner@cullinos.com
E2E_OWNER_PASSWORD=E2eTestOwner123!

# Optional — fall back to owner
E2E_WAITER_EMAIL=
E2E_WAITER_PASSWORD=
E2E_CASHIER_EMAIL=
E2E_CASHIER_PASSWORD=
